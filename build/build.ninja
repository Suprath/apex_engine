#############################################
# Utility command for test

build external/asmjit/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/external/asmjit && /usr/bin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build external/asmjit/test: phony external/asmjit/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build external/asmjit/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/external/asmjit && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build external/asmjit/edit_cache: phony external/asmjit/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build external/asmjit/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/build/external/asmjit && /usr/bin/cmake --regenerate-during-build -S/workspace -B/workspace/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build external/asmjit/rebuild_cache: phony external/asmjit/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build external/asmjit/list_install_components: phony


#############################################
# Utility command for install

build external/asmjit/CMakeFiles/install.util: CUSTOM_COMMAND external/asmjit/all
  COMMAND = cd /workspace/build/external/asmjit && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

