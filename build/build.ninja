# Phony custom command for CMakeFiles/apex_flatbuffers_gen

build CMakeFiles/apex_flatbuffers_gen | ${cmake_ninja_workdir}CMakeFiles/apex_flatbuffers_gen: phony generated/flatbuffers/market_data_generated.h || external/flatbuffers/flatc


#############################################
# Custom command for generated/flatbuffers/market_data_generated.h

build generated/flatbuffers/market_data_generated.h | ${cmake_ninja_workdir}generated/flatbuffers/market_data_generated.h: CUSTOM_COMMAND /workspace/fbs/market_data.fbs || external/flatbuffers/flatc
